{
  "name": "dsh-request-guard",
  "version": "0.1.2",
  "description": "Keeps a malformed provider response from wedging or poisoning a DeepSeek Harness session: fills empty tool-call ids on the write side, repairs the outbound message array (nameless calls, orphan/stranded results, missing results, bad arguments), and retries a pairing 400 once.",
  "author": "Dinwlooc",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "tool-call",
    "stream",
    "repair",
    "session-recovery",
    "anthropic-adjacency"
  ],
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./repair": "./lib/repair.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./client": {
      "default": "./client.js"
    }
  },
  "files": [
    "index.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg",
    "client.js",
    "settings.js"
  ],
  "scripts": {
    "test": "node test/run.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": []
    }
  }
}
