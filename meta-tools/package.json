{
  "name": "dsh-meta-tools",
  "version": "0.2.0",
  "description": "Meta-layer library tools for DeepSeek Harness: route, read/write/search/guard-delete a workspace prompt & knowledge library keyed by model and task type",
  "author": "Dinwlooc",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "meta-layer",
    "routing",
    "knowledge-library",
    "revlog",
    "task-types"
  ],
    "type": "module",
  "main": "lib/index.js",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "@deepseek-ai/cosmokit": "~1.8.6"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": []
    }
  }
}
